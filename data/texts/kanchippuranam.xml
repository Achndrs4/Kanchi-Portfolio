  <text>
    <body>
      <div type="chapter" n="1" xml:id="KP-ch1" corresp="#KM-S-ch1">
        <head xml:lang="tam">காஞ்சி மான்மியம்</head>
        <lg type="verse" n="1" xml:id="KP-1" corresp="#KM-S-1">
          <l n="1a">
            <placeName ref="authority:place-kanchipuram">காஞ்சி</placeName>
            நகரில்
            <app>
              <lem wit="#T1">சிவன்</lem>
              <rdg wit="#T2">சிவனார்</rdg>
            </app>
          </l>
          <l n="1b">என்றும் உறைகின்றார்</l>
        </lg>
        <lg type="verse" n="2" xml:id="KP-2" corresp="#KM-S-2">
          <l n="2a">
            <persName ref="authority:deity-kamakshi" type="deity">காமாட்சி</persName>
            அம்மை
          </l>
          <l n="2b">
            <app>
              <lem wit="#T1 #T2">தவத்தால்</lem>
              <rdg wit="#T2" cause="variant-spelling">தவத்தினால்</rdg>
            </app>
            சித்தி பெறுவார்
          </l>
        </lg>
      </div>
    </body>
